# ============================================================
# ECG-AI — Variables de entorno (EJEMPLO)
# ============================================================
# Copia este archivo a `.env` y ajusta los valores:
#     cp .env.example .env
#
# ⚠️  `.env` NUNCA se sube al repo (está en .gitignore).
#     En CI/CD usa GitHub Secrets. No pongas secretos reales aquí.
# ============================================================

# ---------- PostgreSQL (servicio `postgres`) ----------
POSTGRES_USER=ecg
POSTGRES_PASSWORD=cambia_en_env
POSTGRES_DB=ecg

# ---------- Backend ----------
# Se construye automáticamente en docker-compose.yml a partir de las
# variables de PostgreSQL. Solo descomenta si usas una DB externa:
# DATABASE_URL=postgresql://ecg:cambia_en_env@postgres:5432/ecg

# Ruta del artefacto del modelo real (T11c + T11d). La genera el CLI de
# entrenamiento en el host. Las rutas por defecto son RELATIVAS AL CWD, y
# el compose monta ./data de la RAÍZ del repo (→ /app/data en el
# contenedor), así que hay que entrenar de forma que el artefacto caiga en
# data/models/ de la raíz. Las dos formas válidas (verificadas):
#     # desde la raíz del repo:
#     PYTHONPATH=backend python -m app.train_model
#     # o desde backend/, forzando el destino a la raíz:
#     cd backend && python -m app.train_model --dest ../data/models/baseline.joblib
# Ojo: sin --dest, `cd backend && python -m app.train_model` escribiría en
# backend/data/models/baseline.joblib y el contenedor NO lo vería (caería
# al heurístico). El artefacto (*.joblib) NUNCA se commitea (gitignored);
# el contenedor lo ve montado vía el volumen ./data:/app/data de
# docker-compose.yml.
# Relativa al WORKDIR del proceso (en el contenedor: /app).
# Sin artefacto el backend arranca igual: usa el heurístico (T11a).
# MODEL_PATH=data/models/baseline.joblib

# ---------- Frontend ----------
# URL de la API tal como la ve el navegador (Vite usa prefijo VITE_).
# Ajusta si el frontend usa CRA (REACT_APP_API_URL) u otro framework.
VITE_API_URL=http://localhost:8000
